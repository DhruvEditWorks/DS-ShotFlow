# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ds_shotflow?schema=public"

# Supabase Auth with Google provider enabled in Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Optional AI generation
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Cloudinary signed uploads
CLOUDINARY_CLOUD_NAME="your-cloud"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="ds-shotflow"

# Google Drive sync. OAuth access token can also be supplied per request from Supabase provider session.
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/auth/callback"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
AUTOSAVE_INTERVAL_MS="3500"
NEXT_PUBLIC_AUTOSAVE_INTERVAL_MS="3500"
